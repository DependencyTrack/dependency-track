{#- @pebvariable name="notification" type="org.dependencytrack.notification.proto.v1.Notification" -#}
{#- @pebvariable name="timestamp" type="String" -#}
--------------------------------------------------------------------------------
Notification
  -- timestamp: {{ timestamp }}
  -- level:     {{ notification.level }}
  -- scope:     {{ notification.scope }}
  -- group:     {{ notification.group }}
  -- title:     {{ notification.title }}
  -- content:   {{ notification.content }}{% if notification.group == "GROUP_VULNERABILITY_ANALYSIS_COMMENT" %}
  -- commenter: {% if subject.vulnerabilityAnalysisComment.commenter is not empty %}{{ subject.vulnerabilityAnalysisComment.commenter }}{% else %}System{% endif %} {% if subject.vulnerabilityAnalysisComment.commenterId is not empty %}({{ subject.vulnerabilityAnalysisComment.commenterId }}){% endif %}
  -- comment:   {{ subject.vulnerabilityAnalysisComment.content }}{% endif %}
