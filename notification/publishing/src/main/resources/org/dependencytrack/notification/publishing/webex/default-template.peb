{"markdown":"**{{ notification.title | escape(strategy="json") }}**{% if notification.group == "GROUP_NEW_VULNERABILITY" %}\n**VulnID:** {{ subject.vulnerability.vulnId | escape(strategy="json") }}\n**Severity:** {{ subject.vulnerability.severity | escape(strategy="json") }}\n**Source:** {{ subject.vulnerability.source | escape(strategy="json") }}\n**Component:** {{ subject.component | summarize | escape(strategy="json") }}\n**Actions:**\n[View Vulnerability]({{ baseUrl }}/vulnerability/?source={{ subject.vulnerability.source | escape(strategy="json") }}&vulnId={{ subject.vulnerability.vulnId | escape(strategy="json") }}){% elseif notification.group == "GROUP_NEW_VULNERABLE_DEPENDENCY" %}\n**Project:** {{ subject.project | summarize | escape(strategy="json") }}\n**Component:** {{ subject.component | summarize | escape(strategy="json") }}\n**Actions:**\n[View Project]({{ baseUrl }}/projects/?uuid={{ subject.project.uuid | escape(strategy="json") }}){% elseif notification.group == "GROUP_POLICY_VIOLATION_UPDATED" or notification.group == "GROUP_POLICY_VIOLATION_UPDATED_REVIEWED" %}\n**Project:** {{ subject.project | summarize | escape(strategy="json") }}\n**Policy:** {{ subject.policyViolation.condition.policy.name | escape(strategy="json") }}\n**Previous Message:** {{ subject.previousMessage | escape(strategy="json") }}\n**Current Message:** {{ subject.currentMessage | escape(strategy="json") }}\n**Changed At:** {{ subject.changedAt | formatTimestamp | escape(strategy="json") }}\n**Violation UUID:** {{ subject.policyViolation.uuid | escape(strategy="json") }}{% if notification.group == "GROUP_POLICY_VIOLATION_UPDATED_REVIEWED" %}\n**Analysis State:** {{ subject.analysisState | escape(strategy="json") }}\n**Suppressed:** {% if subject.hasSuppressed() %}{{ subject.suppressed }}{% else %}not recorded{% endif %}\nReview decision retained{% endif %}{% endif %}{% if subject.component is defined %}\n[View Component]({{ baseUrl }}/component/?uuid={{ subject.component.uuid | escape(strategy="json") }}){% endif %}\n**Description:** {{ notification.content | escape(strategy="json") }}"}